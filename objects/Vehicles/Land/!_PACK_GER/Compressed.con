rem ===== EOF =====
rem ============================================================================
rem folder = leFH18Battery_HF
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo leFH18BatteryTraverseInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo leFH18BatteryTurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo leFH18BatteryGunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo leFH18BatteryBodyInfo
NetworkableInfo.setPredictionMode PMLinear

rem ===== EOF =====
rem ============================================================================
rem folder = leFH18Battery_HF
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1

