rem ===== EOF =====
rem ============================================================================
rem folder = Puma
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1


rem *** puma ***
ObjectTemplate.create PlayerControlObject Puma
ObjectTemplate.setNetworkableInfo pumaBodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasDynamicShadow 1
ObjectTemplate.explosionRadius 8
ObjectTemplate.explosionDamage 2
ObjectTemplate.drag 1
ObjectTemplate.dragOffset 0/0/0
ObjectTemplate.mass 11700
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.hasArmor 1
ObjectTemplate.speedMod 1
ObjectTemplate.exitTimer 1
ObjectTemplate.hitpoints 86
ObjectTemplate.Maxhitpoints 86
ObjectTemplate.material 34
ObjectTemplate.criticalDamage 8
ObjectTemplate.explosionForceMod 10
if v_is_coop == True
	ObjectTemplate.hpLostWhileCriticalDamage 1
else
	ObjectTemplate.hpLostWhileCriticalDamage 0
endIf
ObjectTemplate.hpLostWhileUpSideDown 5
ObjectTemplate.hpLostWhileDamageFromWater 5
ObjectTemplate.addArmorEffect 30 e_KatyushaDamage 0/0.7/-1.2
ObjectTemplate.addArmorEffect 8 e_KatyushaFire 0/0.35/-1.2
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/-1/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/-1/0
ObjectTemplate.addArmorEffect -1 WaterWaterExplosion 0/-1/0
ObjectTemplate.timetoliveafterdeath 25
ObjectTemplate.fadeAtTimeToLiveAfterDeath 0
ObjectTemplate.damageFromWater 0
ObjectTemplate.aiTemplate puma
rem -------------------------------------
ObjectTemplate.addTemplate lodpuma
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation -2/0/0 0/0/0
ObjectTemplate.GUIIndex 24
ObjectTemplate.submarineData 1 0.03 10.0 1.8 1.8 1.2 5
ObjectTemplate.setVehicleIcon "Vehicle/Icon_puma.tga"
ObjectTemplate.setVehicleIconPos 62/67
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_50mmKwK39RndAPCR.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setSecondaryAmmoIcon "Ammo/icon_7,92mmMG42.tga"
ObjectTemplate.setSecondaryAmmoBar ABAmmoBarHeatBar
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_armcar_16x16.tga"
ObjectTemplate.setHasTurretIcon 1
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTLightTank
ObjectTemplate.setToolTipType  TTLightTank
ObjectTemplate.hasRestrictedExit 1



