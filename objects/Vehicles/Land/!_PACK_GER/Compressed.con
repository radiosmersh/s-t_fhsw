rem ===== EOF =====
rem ============================================================================
rem folder = 20,3cm_H503(r)
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo H503(r)TurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo H503(r)GunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo H503(r)BodyInfo
NetworkableInfo.setPredictionMode PMLinear


rem ===== EOF =====
rem ============================================================================
rem folder = 20,3cm_H503(r)
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER
Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1


rem *** H503(r) ***
ObjectTemplate.create PlayerControlObject 20,3cm_H503(r)
ObjectTemplate.setNetworkableInfo H503(r)BodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.explosionRadius 4
ObjectTemplate.explosionDamage 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 121
ObjectTemplate.maxhitpoints 121
ObjectTemplate.material 34
ObjectTemplate.addArmorEffect 40 e_PanzDamage 0/1.3/0
ObjectTemplate.addArmorEffect 12 e_PanzFire 0/1.0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke 0/0/0
ObjectTemplate.aiTemplate H503(r)
ObjectTemplate.timetoliveafterdeath 10
ObjectTemplate.geometry H503(r)_thing_m1
rem -------------------------------------
ObjectTemplate.addTemplate lodH503(r)
ObjectTemplate.setPosition 0/0.6/0
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation -2/0/0 0/0/0
ObjectTemplate.GUIIndex 19
ObjectTemplate.setVehicleIcon "Vehicle/icon_H503(r).tga"
ObjectTemplate.setVehicleIconPos 74/96
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_203mmH503(r).tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_artillery_16x16.tga"
ObjectTemplate.artPos 1
ObjectTemplate.DirBarXScale 180
ObjectTemplate.DirBarYScaleAbove 90
ObjectTemplate.DirBarYScaleBelow 0
ObjectTemplate.DirBarYScaleMin -90
ObjectTemplate.DirBarYScaleMax 0

rem *** lodH503(r) ***
ObjectTemplate.create LodObject lodH503(r)
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate H503(r)Complex
ObjectTemplate.addTemplate H503(r)Simple
ObjectTemplate.addTemplate H503(r)Wreck
rem -------------------------------------
ObjectTemplate.lodSelector H503(r)LodSelector


rem *** H503(r)Complex ***
ObjectTemplate.create RotationalBundle H503(r)Complex
ObjectTemplate.setNetworkableInfo H503(r)BodyInfo
ObjectTemplate.loadSoundScript ../B4howitzer/Sounds/B4howitzerTraverse.ssc
ObjectTemplate.geometry H503(r)_base_m1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate H503(r)_Entry
ObjectTemplate.addTemplate H503(r)_Tower
ObjectTemplate.setPosition 0/0.44/-0.37

ObjectTemplate.addTemplate H503(r)_Track_Left
ObjectTemplate.addTemplate H503(r)_Track_Right
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMaxSpeed 2/0/0
	ObjectTemplate.setAcceleration 4/0/0
	ObjectTemplate.setInputToYaw c_PIYaw
else
	ObjectTemplate.setMaxSpeed 4/0/0
	ObjectTemplate.setAcceleration 50/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

rem *** H503(r)_Entry ***
ObjectTemplate.create EntryPoint H503(r)_Entry
ObjectTemplate.setEntryRadius 3.8

rem *** H503(r)_Tower ***
ObjectTemplate.create RotationalBundle H503(r)_Tower
ObjectTemplate.setNetworkableInfo H503(r)TurretInfo
ObjectTemplate.loadSoundScript ../B4howitzer/Sounds/B4howitzerTower.ssc
ObjectTemplate.geometry H503(r)_carriage_m1
ObjectTemplate.hasCollisionPhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate H503(r)GunBase
ObjectTemplate.setPosition 0/0.8825/0.5195

ObjectTemplate.addTemplate H503(r)_GunnerSeat
ObjectTemplate.setPosition -1.0/0.95/-0.5
ObjectTemplate.setRotation 45/0/0

ObjectTemplate.addTemplate H503(r)_handle1
ObjectTemplate.setPosition -0.5573/0.3076/1.1671
ObjectTemplate.setRotation 4/24/0

ObjectTemplate.addTemplate H503(r)_handle2
ObjectTemplate.setPosition 0.7389/0.5795/-0.0241
ObjectTemplate.setRotation -3.5/0/0

ObjectTemplate.addTemplate H503(r)_handle3
ObjectTemplate.setPosition -0.7995/0.8955/0.3503
ObjectTemplate.setRotation 3.5/0/0
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMinRotation -4/0/0
	ObjectTemplate.setMaxRotation 4/0/0
	ObjectTemplate.setMaxSpeed 5/0/0
	ObjectTemplate.setAcceleration 40/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf


