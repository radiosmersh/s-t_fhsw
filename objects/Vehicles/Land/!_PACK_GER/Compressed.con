rem *** JagdtigerEngine ***
ObjectTemplate.create Engine JagdtigerEngine
ObjectTemplate.setNetworkableInfo JagdtigerEngineInfo
ObjectTemplate.setAttachToListener 1
ObjectTemplate.loadSoundScript ../Engines/Sounds/TigerEngine.ssc
ObjectTemplate.hasMobilePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate JagdtigerTrackL
ObjectTemplate.setPosition -0.001/0/0
ObjectTemplate.addTemplate JagdtigerTrackR
ObjectTemplate.setPosition 0.001/0/0

ObjectTemplate.addTemplate e_TankExhaust20
ObjectTemplate.setPosition -0.375/0.8716/-4.1011
ObjectTemplate.setRotation 0/-85/0
ObjectTemplate.addTemplate e_TankExhaust20
ObjectTemplate.setPosition 0.375/0.8716/-4.1011
ObjectTemplate.setRotation 0/-85/0
rem -------------------------------------
ObjectTemplate.setMinRotation -1/0/-1
ObjectTemplate.setMaxRotation 1/0/1
ObjectTemplate.setMaxSpeed 4/0/10
ObjectTemplate.setAcceleration 3/0/8
ObjectTemplate.setInputToYaw c_PIYaw
ObjectTemplate.setInputToRoll c_PIThrottle
ObjectTemplate.setAutomaticReset 1
ObjectTemplate.setEngineType c_ETTank
rem *** 10.0 HP/t
ObjectTemplate.setTorque 1.92
rem *** 38 km/h
ObjectTemplate.setDifferential 2.85
ObjectTemplate.setNumberOfGears 5
ObjectTemplate.setGearUp 0.95
ObjectTemplate.setGearDown 0.45
ObjectTemplate.setGearChangeTime 0.05

