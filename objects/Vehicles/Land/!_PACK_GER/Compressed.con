NetworkableInfo.createNewInfo OstwindGunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo OstwindEngineInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo OstwindBodyInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo Ostwind_BodyInfo
NetworkableInfo.setPredictionMode PMLinear


rem ===== EOF =====
rem ============================================================================
rem folder = Ostwind
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1


