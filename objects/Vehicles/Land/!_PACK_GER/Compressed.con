rem ============================================================================
rem folder = Pz739
rem sauce = Weapons.con
rem ============================================================================

rem *** Pz739GunBarrel ***
ObjectTemplate.create FireArms Pz739GunBarrel
ObjectTemplate.setNetworkableInfo TankFireArmInfo
ObjectTemplate.loadSoundScript ../Pz739/Sounds/Pz739Cannon.ssc
ObjectTemplate.geometry Pz739_Cannon_M1
ObjectTemplate.aiTemplate Pz739MainGun
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_50_500_Main
ObjectTemplate.setPosition 0.0017/0.0052/0.7452
rem -------------------------------------
ObjectTemplate.setMinDev 0.63
ObjectTemplate.projectileTemplate 47mmL32F_Projectile
ObjectTemplate.projectilePosition 0/0/1
ObjectTemplate.magSize 100
ObjectTemplate.numOfMag 1
ObjectTemplate.velocity 295
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 0.3
ObjectTemplate.roundOfFire 0.452
ObjectTemplate.fireingForce 20
ObjectTemplate.recoilSpeed 10
ObjectTemplate.recoilSize 10
ObjectTemplate.setFireCameraShakeAnimationState FireTank50CanonShake

