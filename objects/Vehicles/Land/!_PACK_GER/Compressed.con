rem ============================================================================
rem folder = Pak38
rem sauce = Weapons.con
rem ============================================================================

rem *** pak38_gun_fire_AP ***
ObjectTemplate.create FireArms pak38Gun_AP
ObjectTemplate.setNetworkableInfo TankFireArmInfo
ObjectTemplate.loadSoundScript ../Pak38/Sounds/pak38GunBarrel.ssc
ObjectTemplate.aiTemplate pak38MainGun
ObjectTemplate.geometry pak38_Cannon_M1
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_37_750_Main
ObjectTemplate.setPosition 0.0172/0.0595/3.0919

ObjectTemplate.addTemplate e_MuzzSW_50_750_Sub
ObjectTemplate.setPosition -0.0662/0.0595/2.9924
ObjectTemplate.setRotation -90/0/0
ObjectTemplate.addTemplate e_MuzzSW_50_750_Sub
ObjectTemplate.setPosition 0.1006/0.0595/2.9924
ObjectTemplate.setRotation 90/0/0
ObjectTemplate.addTemplate e_MuzzSW_50_750_Sub
ObjectTemplate.setPosition -0.0555/0.0595/2.866
ObjectTemplate.setRotation -105/0/0
ObjectTemplate.addTemplate e_MuzzSW_50_750_Sub
ObjectTemplate.setPosition 0.0899/0.0595/2.866
ObjectTemplate.setRotation 105/0/0

ObjectTemplate.addTemplate e_CartridgeEjection_50x419R
ObjectTemplate.setInputId 0
ObjectTemplate.startoneffects 1
ObjectTemplate.setPosition 0.02/0.06/-1.37
rem -------------------------------------
ObjectTemplate.projectileTemplate 50mmL60_Projectile
ObjectTemplate.projectilePosition 0/0/3
ObjectTemplate.magSize 99
ObjectTemplate.setMinDev 0.43
ObjectTemplate.numOfMag 1
ObjectTemplate.velocity 418
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 0.35
ObjectTemplate.roundOfFire 0.46
rem towed gun tweak
rem ObjectTemplate.fireingForce 40
ObjectTemplate.recoilSpeed 10
ObjectTemplate.recoilSize 25
ObjectTemplate.setFireCameraShakeAnimationState FireTank50CanonShake

