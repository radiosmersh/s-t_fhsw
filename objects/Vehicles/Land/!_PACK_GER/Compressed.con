rem *** JagdtigerGunBarrel ***
ObjectTemplate.create FireArms JagdtigerGunBarrel
ObjectTemplate.setNetworkableInfo TankFireArmInfo
ObjectTemplate.loadSoundScript ../Jagdtiger/Sounds/JagdtigerCannon.ssc
ObjectTemplate.geometry Jagdtiger_Gunbarrel_m1
ObjectTemplate.aiTemplate JagdtigerMainGun
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_130_1000_Main
ObjectTemplate.setPosition 0/0/5.165
rem -------------------------------------
ObjectTemplate.projectileTemplate 128mmL55_Projectile
ObjectTemplate.projectilePosition 0/0/1
ObjectTemplate.setMinDev 0.27
ObjectTemplate.magSize 40
ObjectTemplate.numOfMag 1
ObjectTemplate.velocity 460
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 0.3
ObjectTemplate.roundOfFire 0.112
