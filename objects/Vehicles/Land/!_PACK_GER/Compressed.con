ObjectTemplate.dieAfterColl 0
ObjectTemplate.radius 12
rem ObjectTemplate.radius 4
ObjectTemplate.ForceOnExplosion 30
ObjectTemplate.explodeNearEnemyDistance 2
ObjectTemplate.hasOnTimeEffect 1
ObjectTemplate.mass 150
ObjectTemplate.material 230
ObjectTemplate.material2 232
ObjectTemplate.damageType 1
ObjectTemplate.endEffectTemplate e_ExploLarge


