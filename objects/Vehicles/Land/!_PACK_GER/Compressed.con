rem *** RatteAdditionalPCOEngine ***
ObjectTemplate.create Engine RatteAdditionalPCOEngine
ObjectTemplate.setNetworkableInfo RatteAddPCOEngineInfo
ObjectTemplate.hasMobilePhysics 1
rem -------------------------------------
ObjectTemplate.setMinRotation -1/0/-1
ObjectTemplate.setMaxRotation 1/0/1
ObjectTemplate.setMaxSpeed 4/0/10
ObjectTemplate.setAcceleration 3/0/8
ObjectTemplate.setInputToYaw c_PINone
ObjectTemplate.setInputToRoll c_PINone
ObjectTemplate.setInputToPitch c_PINone
ObjectTemplate.setAutomaticReset 1
ObjectTemplate.setEngineType c_ETTank
ObjectTemplate.setTorque 2.03
