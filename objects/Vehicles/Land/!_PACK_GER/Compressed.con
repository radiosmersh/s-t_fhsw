ObjectTemplate.setVehicleIcon "Vehicle/icon_jagdpanther.tga"
ObjectTemplate.setVehicleIconPos 68/90
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_88mmPaK43,3.tga"
