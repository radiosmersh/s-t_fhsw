rem ============================================================================
rem folder = leFH18_HF
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo leFH18TurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo leFH18GunInfo
NetworkableInfo.setPredictionMode PMLinear

