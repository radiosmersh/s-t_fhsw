rem folder = Pak38
rem sauce = Geometries.con
rem ============================================================================
renderer.beginGlobalCluster pak38

GeometryTemplate.create StandardMesh pak38_1P
GeometryTemplate.file pak38_1P

GeometryTemplate.create StandardMesh 1p_Pak38Aim_m1
GeometryTemplate.file 1p_Pak38Aim_m1

GeometryTemplate.create StandardMesh pak38_Cannon_M1
GeometryTemplate.file pak38_barrel_M1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_mount_M1
GeometryTemplate.file pak38_mount_M1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_slider_M1
GeometryTemplate.file pak38_slider_M1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_carriage_M1
GeometryTemplate.file pak38_carriage_M1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_mobile_carriage_m1
GeometryTemplate.file pak38_mobile_carriage_m1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_towed_carriage_m1
GeometryTemplate.file pak38_towed_carriage_m1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_wheel2_m1
GeometryTemplate.file pak38_wheel2_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_wheel1_m1
GeometryTemplate.file pak38_wheel1_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_mobile_wheel_R_m1
GeometryTemplate.file pak38_mobile_wheel_R_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_mobile_wheel_L_m1
GeometryTemplate.file pak38_mobile_wheel_L_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

renderer.endGlobalCluster

GeometryTemplate.create StandardMesh pak38_low
GeometryTemplate.file pak38_L1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh pak38_Wreck_M1
GeometryTemplate.file pak38_Wreck_M1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 150
GeometryTemplate.setLodDistance 2 200
GeometryTemplate.setLodDistance 3 250
GeometryTemplate.setLodDistance 4 300
GeometryTemplate.setLodDistance 5 500

rem ===== EOF =====
rem ============================================================================
rem folder = Pak38
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo pak38BodyInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo AT25BodyInfo
NetworkableInfo.setPredictionMode PMLinear

rem ===== EOF =====
rem ============================================================================
rem folder = Pak38
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1

rem *** pak38
rem *** pak38_AP

rem *** pak38 ***
ObjectTemplate.create PlayerControlObject pak38
ObjectTemplate.setNetworkableInfo pak38BodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.explosionRadius 5
ObjectTemplate.explosionDamage 1
ObjectTemplate.explosionForceMod 15
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 88
ObjectTemplate.maxhitpoints 88
ObjectTemplate.material 33
ObjectTemplate.addArmorEffect 30 e_AA-GunDamage 0/0.3/0
ObjectTemplate.addArmorEffect 0 e_Scrappak38 0/1.2/0
ObjectTemplate.addArmorEffect 0 e_ScrapMetal 0/1.2/0
ObjectTemplate.aiTemplate pak38
ObjectTemplate.timetoliveafterdeath 0
rem -------------------------------------
ObjectTemplate.addTemplate lodpak38
ObjectTemplate.setPosition 0/0.65/0
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation -2/0.5/0 0/0/0
ObjectTemplate.GUIIndex 19
ObjectTemplate.setVehicleIcon "Vehicle/Icon_pak38.tga"
ObjectTemplate.setVehicleIconPos 75/75
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_50mmPaK38RndAPCR.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_atgun_16x16.tga"
ObjectTemplate.artPos 1
ObjectTemplate.DirBarXScale 180
ObjectTemplate.DirBarYScaleAbove 90
ObjectTemplate.DirBarYScaleBelow 0
ObjectTemplate.DirBarYScaleMin -90
ObjectTemplate.DirBarYScaleMax 0
ObjectTemplate.setPosition 0.0/0.65/0.0

rem *** lodpak38 ***
ObjectTemplate.create LodObject lodpak38
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate pak38Complex
ObjectTemplate.addTemplate pak38Simple
rem -------------------------------------
ObjectTemplate.lodSelector pak38LodSelector

rem *** pak38Complex ***
ObjectTemplate.create RotationalBundle pak38Complex
ObjectTemplate.setNetworkableInfo pak38BodyInfo
ObjectTemplate.loadSoundScript ../Common/Sounds/Traverse_Mediumgun.ssc
ObjectTemplate.geometry pak38_carriage_M1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate pak38Entry
ObjectTemplate.addTemplate pak38Mount
ObjectTemplate.setPosition 0.0/0.175239/0.0
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMaxSpeed 5/0/0
	ObjectTemplate.setAcceleration 10/0/0
	ObjectTemplate.setInputToYaw c_PIYaw
else
	ObjectTemplate.setMaxSpeed 16/0/0
	ObjectTemplate.setAcceleration 72/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

rem *** pak38Entry ***
ObjectTemplate.create EntryPoint pak38Entry
ObjectTemplate.setEntryRadius 3.2

rem *** pak38Mount ***
ObjectTemplate.create RotationalBundle pak38Mount
ObjectTemplate.geometry pak38_mount_M1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.setNetworkableInfo pak38BodyInfo
ObjectTemplate.loadSoundScript ../Pak38/Sounds/pak38Carriage.ssc
rem -------------------------------------
ObjectTemplate.addTemplate pak38Slider
ObjectTemplate.setPosition 0.0/0.39297/-0.25
rem ObjectTemplate.setPosition 0/0/0
ObjectTemplate.addTemplate pak38Seat
ObjectTemplate.setPosition -0.6/0.25797/-1.0
ObjectTemplate.addTemplate pak38Wheel1
ObjectTemplate.setPosition -0.508839/0.150901/-0.456762
ObjectTemplate.setRotation 75.4615/-89.538/-90.0003
ObjectTemplate.addTemplate pak38Wheel2
ObjectTemplate.setPosition -0.342347/0.133389/-0.58525
ObjectTemplate.setRotation 5.34058e-005/15.5246/-180.0

ObjectTemplate.addTemplate pak38CamBase
ObjectTemplate.setPosition -0.5/0.5/0.2
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMinRotation -32.5/0/0
	ObjectTemplate.setMaxRotation 32.5/0/0
	ObjectTemplate.setMaxSpeed 16/0/0
	ObjectTemplate.setAcceleration 72/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf


rem *** Flak38CockpitExternal ***
ObjectTemplate.create SimpleObject pak38CockpitExternal
ObjectTemplate.geometry pak38_slider_M1
ObjectTemplate.hasCollisionPhysics 1

rem *** Flak38CockpitInternal ***
ObjectTemplate.create SimpleObject pak38CockpitInternal
ObjectTemplate.geometry pak38_1P

rem *** flak38CockpitSelector ***
LodSelectorTemplate.create DistCompareSelector pak38CockpitSelector
LodSelectorTemplate.addLodDistance 2
LodSelectorTemplate.addLodComparison 0.5

rem *** lodFlak38Cockpit ***
ObjectTemplate.create LodObject lodpak38Cockpit
rem -------------------------------------
ObjectTemplate.addTemplate pak38CockpitExternal
ObjectTemplate.addTemplate pak38CockpitInternal
ObjectTemplate.setPosition -0.11/-0.742/0.34
ObjectTemplate.setRotation 32/0/0
rem -------------------------------------
ObjectTemplate.lodSelector pak38CockpitSelector


rem *** pak38Slider ***
ObjectTemplate.create RotationalBundle pak38Slider
ObjectTemplate.geometry pak38_slider_M1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.setNetworkableInfo pak38BodyInfo
ObjectTemplate.loadSoundScript ../Pak38/Sounds/pak38GunBase.ssc
rem -------------------------------------
ObjectTemplate.addTemplate pak38Gun
rem -------------------------------------
ObjectTemplate.setMinRotation 0/-27/0
ObjectTemplate.setMaxRotation 0/8/0
ObjectTemplate.setMaxSpeed 0/16/0
ObjectTemplate.setAcceleration 0/72/0
ObjectTemplate.setInputToPitch c_PIMouseLookY


rem *** pak38_Entry ***
ObjectTemplate.create RotationalBundle pak38Wheel1
ObjectTemplate.geometry pak38_wheel1_m1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.setNetworkableInfo AT25BodyInfo
rem -------------------------------------
ObjectTemplate.addTemplate pak38HandleGrip1
rem -------------------------------------
ObjectTemplate.setMaxSpeed 0/800/0
ObjectTemplate.setAcceleration 0/3000/0
ObjectTemplate.setInputToPitch c_PIMouseLookX

rem *** pak38_Entry ***
ObjectTemplate.create RotationalBundle pak38Wheel2
ObjectTemplate.geometry pak38_wheel2_m1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.setNetworkableInfo AT25BodyInfo
rem -------------------------------------
ObjectTemplate.addTemplate pak38HandleGrip2
rem -------------------------------------
ObjectTemplate.setMaxSpeed 0/0/800
ObjectTemplate.setAcceleration 0/0/-3000
ObjectTemplate.setInputToRoll c_PIMouseLookY


rem *** pak38CamBase ***
ObjectTemplate.create RotationalBundle pak38CamBase
ObjectTemplate.setNetworkableInfo pak38BodyInfo
rem -------------------------------------
ObjectTemplate.addTemplate pak38Camera
ObjectTemplate.setPosition 0.1/0.3/-1.1
ObjectTemplate.addTemplate lodpak38GunnerCockpit
rem -------------------------------------
ObjectTemplate.setMinRotation 0/-27/0
ObjectTemplate.setMaxRotation 0/8/0
ObjectTemplate.setMaxSpeed 0/16/0
ObjectTemplate.setAcceleration 0/72/0
ObjectTemplate.setInputToPitch c_PIMouseLookY

rem *** lodpak38GunnerCockpit ***
ObjectTemplate.create LodObject lodpak38GunnerCockpit
rem -----------------------------------------------------
ObjectTemplate.addTemplate pak38GunnerCockpitInternal
ObjectTemplate.addTemplate pak38GunnerCockpitExternal
rem -----------------------------------------------------
ObjectTemplate.lodselector pak38GunnerCockpitSelector

rem *** pak38GunnerCockpitExternal ***
ObjectTemplate.create SimpleObject pak38GunnerCockpitExternal
ObjectTemplate.geometry 

rem *** pak38GunnerCockpitInternal ***
ObjectTemplate.create SimpleObject pak38GunnerCockpitInternal
ObjectTemplate.geometry 1p_Pak38Aim_m1

rem *** pak38GunnerCockpitSelector ***
LodSelectorTemplate.create DistanceSelector pak38GunnerCockpitSelector
LodSelectorTemplate.addLodDistance 0.1

rem *** pak38_Camera ***
ObjectTemplate.create Camera pak38Camera
ObjectTemplate.OutsideHudOffset -0.1/-0.3/1.1
ObjectTemplate.CVMExternTrace 1

rem *** pak38Seat ***
ObjectTemplate.create SeatObject pak38Seat
ObjectTemplate.seatFlags c_SeatShowFullBodySoldier
ObjectTemplate.seatFlags c_SeatIsOutside
ObjectTemplate.seatAnimationLowerBody Lb_CrouchTripodGunner

rem *** pak38HandleGrip1 ***
ObjectTemplate.create AnimatedBundle pak38HandleGrip1
ObjectTemplate.addSkeletonIK Bip01_L_Hand -0.08/0/0.06 90/0/-90

rem *** pak38HandleGrip2 ***
ObjectTemplate.create AnimatedBundle pak38HandleGrip2
ObjectTemplate.addSkeletonIK Bip01_R_Hand 0.0/0.1/-0.1 -90/180/0

rem *** pak38Simple ***
ObjectTemplate.create SimpleObject pak38Simple
ObjectTemplate.geometry pak38_low

rem *** pak38LodSelector***
LodSelectorTemplate.create DistCompareSelector2 pak38LodSelector
LodSelectorTemplate.hasDestroyedLod 0

rem - Tosses from Explosions.

rem *** Pak38Wreck ***
ObjectTemplate.create SimpleObject Pak38_Wreck_M1
ObjectTemplate.geometry Pak38_Wreck_M1


rem *** pak38_Cannon_Toss ***
ObjectTemplate.create SimpleObject pak38_Cannon_Toss
ObjectTemplate.geometry pak38_barrel_M1
ObjectTemplate.setHasResponsePhysics 1
ObjectTemplate.destroyed 1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.sinkInToLandAfterDeathSpeed 10

rem *** pak38_Mount_Toss ***
ObjectTemplate.create SimpleObject pak38_Mount_Toss
ObjectTemplate.geometry pak38_mount_M1
ObjectTemplate.setHasResponsePhysics 1
ObjectTemplate.destroyed 1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.sinkInToLandAfterDeathSpeed 10

rem *** pak38_Slider_Toss ***
ObjectTemplate.create SimpleObject pak38_Slider_Toss
ObjectTemplate.geometry pak38_slider_M1
ObjectTemplate.setHasResponsePhysics 1
ObjectTemplate.destroyed 1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.sinkInToLandAfterDeathSpeed 10

rem *** pak38_Carriage_Toss ***
ObjectTemplate.create SimpleObject pak38_Carriage_Toss
ObjectTemplate.geometry pak38_carriage_M1
ObjectTemplate.setHasResponsePhysics 1
ObjectTemplate.destroyed 1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.sinkInToLandAfterDeathSpeed 10

