ObjectTemplate.setPosition -0.5888/0.3128/-0.3536
ObjectTemplate.setRotation 90/-57.538/-90
ObjectTemplate.addTemplate Pak40Wheel2
ObjectTemplate.setPosition -0.3928/0.4104/-0.3776
ObjectTemplate.setRotation 0/0/179.999

ObjectTemplate.addTemplate Pak40CamBase
ObjectTemplate.setPosition -0.4/0.56/0
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMinRotation -32.5/0/0
	ObjectTemplate.setMaxRotation 32.5/0/0
	ObjectTemplate.setMaxSpeed 11/0/0
	ObjectTemplate.setAcceleration 60/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

