rem *** H607(r)BatteryGunBarrel ***
ObjectTemplate.create FireArms H607(r)BatteryGunBarrel
ObjectTemplate.setNetworkableInfo TankFireArmInfo
ObjectTemplate.loadSoundScript ../Br5/Sounds/Br5Cannon.ssc
ObjectTemplate.geometry H607(r)_gunbarrel_m1
ObjectTemplate.aiTemplate H503(r)BatteryMainGun
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_280_500_Main
ObjectTemplate.setPosition 0/0/3.8711
rem -------------------------------------
ObjectTemplate.projectileTemplate Arty28,0cmL17Projectile
ObjectTemplate.projectilePosition 0/0/1.5
ObjectTemplate.setMinDev 1.07
ObjectTemplate.magSize 1
ObjectTemplate.numOfMag 50
ObjectTemplate.velocity 225
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 28.2
ObjectTemplate.roundOfFire 10
rem towed gun tweak
rem ObjectTemplate.fireingForce 150
ObjectTemplate.recoilSpeed 8
ObjectTemplate.recoilSize 40
ObjectTemplate.setFireCameraShakeAnimationState ShipBigCanon

rem *** H607(r)BatteryGunBarrel2 ***
