rem *** SdKfz7Engine ***
ObjectTemplate.create Engine SdKfz7Engine
ObjectTemplate.setNetworkableInfo SdKfz7EngineInfo
ObjectTemplate.setAttachToListener 1
ObjectTemplate.loadSoundScript ../Engines/Sounds/HanomagEngine.ssc
ObjectTemplate.hasMobilePhysics 1
