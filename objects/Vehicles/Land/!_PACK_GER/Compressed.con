rem ============================================================================
rem folder = 20,3cm_H503(r)
rem sauce = Weapons.con
rem ============================================================================

rem *** H503(r)GunBarrel ***
ObjectTemplate.create FireArms H503(r)GunBarrel
ObjectTemplate.setNetworkableInfo TankFireArmInfo
ObjectTemplate.loadSoundScript ../B4howitzer/Sounds/B4howitzerCannon.ssc
ObjectTemplate.geometry H503(r)_gunbarrel_m1
ObjectTemplate.aiTemplate H503(r)MainGun
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_200_500_Main
ObjectTemplate.setPosition 0/0/4.1711
rem -------------------------------------
ObjectTemplate.projectileTemplate Arty20,3cmL25Projectile
ObjectTemplate.projectilePosition 0/0/1.5
ObjectTemplate.setMinDev 0.62
ObjectTemplate.magSize 1
ObjectTemplate.numOfMag 50
ObjectTemplate.velocity 304
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 23.8
ObjectTemplate.roundOfFire 10
rem towed gun tweak
rem ObjectTemplate.fireingForce 150
ObjectTemplate.recoilSpeed 8
ObjectTemplate.recoilSize 40
ObjectTemplate.setFireCameraShakeAnimationState ShipBigCanon

rem *** H503(r)GunBarrel_PenetrateExploder ***
ObjectTemplate.create FireArms H503(r)GunBarrel_PenetrateExploder
ObjectTemplate.setNetworkableInfo TankFireArmInfo
rem -------------------------------------
ObjectTemplate.projectileTemplate Arty20,3cmL25Projectile_Penetrator
ObjectTemplate.projectilePosition 0/0/1.5
ObjectTemplate.setMinDev 0.62
ObjectTemplate.magSize 1
ObjectTemplate.numOfMag 50
ObjectTemplate.velocity 304
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 23.8
ObjectTemplate.roundOfFire 10
ObjectTemplate.AmmoType	4

rem *** H503(r)TracGunBarrel ***
ObjectTemplate.create FireArms H503(r)TracGunBarrel
ObjectTemplate.setNetworkableInfo TankFireArmInfo_ForceID
rem -------------------------------------
ObjectTemplate.projectileTemplate Arty20,3cmL25Projectile_Tracer
ObjectTemplate.projectilePosition 0/0/1.5
ObjectTemplate.setMinDev 0
ObjectTemplate.magSize 999
ObjectTemplate.numOfMag 999
ObjectTemplate.velocity 304
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 2
ObjectTemplate.roundOfFire 5
ObjectTemplate.setInputFire c_PIAltFire
ObjectTemplate.AmmoType	5

