rem ============================================================================
rem folder = Tiger
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo TigerTurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo TigerGunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo TigerEngineInfo
NetworkableInfo.setPredictionMode PMLinear

