ObjectTemplate.addTemplate lodWirbelwind
rem ----------------------------------
ObjectTemplate.setSoldierExitLocation -2/0/0 0/0/0
ObjectTemplate.GUIIndex 152
ObjectTemplate.submarineData 1 0.03 10.0 1.5 2.2 1.2 5
ObjectTemplate.setVehicleIcon "Vehicle/icon_Wirbelwind.dds"
ObjectTemplate.setVehicleIconPos 103/35
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_20mmFlak38HET+APT.tga"
