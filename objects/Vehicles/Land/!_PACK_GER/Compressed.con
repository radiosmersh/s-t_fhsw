rem ============================================================================
rem folder = Pak38mobile
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

rem *** Pak38mobile
rem *** Pak38mobile_AP

rem *** Pak38mobile ***
ObjectTemplate.create PlayerControlObject Pak38mobile
ObjectTemplate.setNetworkableInfo Pak38mobileBodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.explosionRadius 4
ObjectTemplate.explosionDamage 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 88
ObjectTemplate.maxhitpoints 88
ObjectTemplate.material 33
rem ObjectTemplate.addArmorEffect 30 e_PanzDamage 0/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.aiTemplate Pak38mobile
ObjectTemplate.timetoliveafterdeath 0
ObjectTemplate.fadeAtTimeToLiveAfterDeath 0
ObjectTemplate.drag 2
ObjectTemplate.mass 2000
ObjectTemplate.hpLostWhileUpSideDown 5
ObjectTemplate.hpLostWhileDamageFromWater 5
ObjectTemplate.damageFromWater 0
ObjectTemplate.speedMod 1
ObjectTemplate.gravityModifier 1.0
rem -------------------------------------
ObjectTemplate.addTemplate lodPak38mobile
ObjectTemplate.setPosition 0/0/0
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation 0.4/0.7/-1 0/0/0
ObjectTemplate.GUIIndex 19
ObjectTemplate.setVehicleIcon "Vehicle/icon_pak38.tga"
ObjectTemplate.setVehicleIconPos 54/60
ObjectTemplate.setNumberOfWeaponIcons 0
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_atgun_16x16.tga"

rem *** lodPak38mobile ***
ObjectTemplate.create LodObject lodPak38mobile
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate Pak38mobileComplex
ObjectTemplate.addTemplate pak38Simple
rem -------------------------------------
ObjectTemplate.lodSelector pak38LodSelector

rem *** Pak38mobileComplex ***
