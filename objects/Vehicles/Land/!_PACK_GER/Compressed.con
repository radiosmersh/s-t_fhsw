rem ===== EOF =====
rem ============================================================================
rem folder = StuG3G_Late
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo StuG3GLateTurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo StuG3GLateBodyInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo StuG3GLatePassengerInfo
NetworkableInfo.setPredictionMode PMNone
NetworkableInfo.setBasePriority 0


rem ===== EOF =====
rem ============================================================================
rem folder = StuG3G_Late
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1

rem *** StuG3G_Late
rem *** StuG3G_LateCamoEdition
rem *** StuG3G_Late_AP
rem *** StuG3G_LateCamoEdition_AP

rem *** StuG3G_Late ***
ObjectTemplate.create PlayerControlObject StuG3G_Late
ObjectTemplate.setNetworkableInfo StuG3GLateBodyInfo
ObjectTemplate.saveInSeparateFile 1
ObjectTemplate.cullRadiusScale 5
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasDynamicShadow 1
ObjectTemplate.explosionRadius 8
ObjectTemplate.explosionDamage 5
ObjectTemplate.exitTimer 1
ObjectTemplate.drag 2
ObjectTemplate.mass 22000
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 98
ObjectTemplate.maxhitpoints 98
ObjectTemplate.material 39
ObjectTemplate.speedMod 0.8
ObjectTemplate.criticalDamage 9
if v_is_coop == True
	ObjectTemplate.hpLostWhileCriticalDamage 1
else
	ObjectTemplate.hpLostWhileCriticalDamage 0
endIf
ObjectTemplate.explosionForceMod 8
ObjectTemplate.hpLostWhileUpSideDown 10
ObjectTemplate.hpLostWhileDamageFromWater 10
ObjectTemplate.addArmorEffect 30 e_PanzDamage 0/1.092/-1.428
ObjectTemplate.addArmorEffect 9 e_PanzFire 0/0.84/-1.344
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.addArmorEffect 0 e_wheelspit 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke 0/0/0
ObjectTemplate.addArmorEffect -1 WaterWaterExplosion 0/0/0
ObjectTemplate.timetoliveafterdeath 30
ObjectTemplate.fadeAtTimeToLiveAfterDeath 0
ObjectTemplate.damageFromWater 0
ObjectTemplate.aiTemplate StuG3G
rem ----------------------------------
ObjectTemplate.addTemplate lodStuG3GLate
rem ----------------------------------
ObjectTemplate.setSoldierExitLocation -0.6/2.1/-0.2 0/0/0
ObjectTemplate.GUIIndex 24
ObjectTemplate.submarineData 1 0.03 10.0 1.5 1.5 1.0 5
ObjectTemplate.setVehicleIcon "Vehicle/icon_StuG3G_late.tga"
ObjectTemplate.setVehicleIconPos 96/85
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_75mmStuK40RndAPCR.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setSecondaryAmmoIcon "Ammo/icon_7,92mmMG34.tga"
ObjectTemplate.setSecondaryAmmoBar ABAmmoBarHeatBar
ObjectTemplate.setHasTurretIcon 1
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTTankHunter
ObjectTemplate.setToolTipType TTSturmGeschutz
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_StuG_16x16.tga"
ObjectTemplate.hasRestrictedExit 1

