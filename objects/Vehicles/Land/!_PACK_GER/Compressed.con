ObjectTemplate.setVehicleIcon "Vehicle/Icon_PantherD.tga"
ObjectTemplate.setVehicleIconPos 55/65
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/Icon_75mmKwK42.tga"
