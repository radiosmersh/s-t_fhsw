rem ===== EOF =====
rem ============================================================================
rem folder = sFH18_BG42
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo sFH18TurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo sFH18AccInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo sFH18GunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo sFH18BodyInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo sFH18GunSelectorInfo
NetworkableInfo.setPredictionMode PMLinear

rem ===== EOF =====
rem ============================================================================
rem folder = sFH18_BG42
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1

rem sFH18
rem sFH18_HEAT_Klw


rem *** sFH18 ***
ObjectTemplate.create PlayerControlObject sFH18
ObjectTemplate.setNetworkableInfo sFH18BodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.explosionRadius 4
ObjectTemplate.explosionDamage 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 104
ObjectTemplate.maxhitpoints 104
ObjectTemplate.material 32
ObjectTemplate.addArmorEffect 40 e_PanzDamage 0/1/-1.4
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.aiTemplate sFH18
ObjectTemplate.timetoliveafterdeath 10
ObjectTemplate.geometry sFH18_root_m1
rem -------------------------------------
ObjectTemplate.addTemplate lodsFH18
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation 0/0.5/-2.0 0/0/0
ObjectTemplate.GUIIndex 19
ObjectTemplate.setVehicleIcon "Vehicle/Icon_sFH18.tga"
ObjectTemplate.setVehicleIconPos 71/83
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_150mmsFH18HE+APHEDS.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_artillery_16x16.tga"
ObjectTemplate.artPos 1
ObjectTemplate.DirBarXScale 180
ObjectTemplate.DirBarYScaleAbove 90
ObjectTemplate.DirBarYScaleBelow 0
ObjectTemplate.DirBarYScaleMin -90
ObjectTemplate.DirBarYScaleMax 0



rem *** lodsFH18 ***
ObjectTemplate.create LodObject lodsFH18
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate sFH18Complex
ObjectTemplate.addTemplate sFH18Simple
ObjectTemplate.addTemplate sFH18Wreck
rem -------------------------------------
ObjectTemplate.lodSelector sFH18LodSelector


rem *** sFH18Complex ***
ObjectTemplate.create RotationalBundle sFH18Complex
ObjectTemplate.setNetworkableInfo sFH18BodyInfo
ObjectTemplate.loadSoundScript ../Common/Sounds/Traverse_Heavygun.ssc
ObjectTemplate.geometry sFH18_carriage_m1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate sFH18Entry
ObjectTemplate.setPosition 0/0/0
ObjectTemplate.addTemplate sFH18Turret
ObjectTemplate.setPosition 0/0.8/-0.3

ObjectTemplate.addTemplate sFH18_Handle_Y
ObjectTemplate.setPosition 1.169/0.984/-1.385
ObjectTemplate.setRotation -30/0/0

ObjectTemplate.addTemplate sFH18_Wheel_L
ObjectTemplate.setPosition -1/0.6/0
ObjectTemplate.addTemplate sFH18_Wheel_R
ObjectTemplate.setPosition 1/0.6/0
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMaxSpeed 5/0/0
	ObjectTemplate.setAcceleration 10/0/0
	ObjectTemplate.setInputToYaw c_PIYaw
else
	ObjectTemplate.setMaxSpeed 10/0/0
	ObjectTemplate.setAcceleration 58/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

rem *** sFH18Entry ***
ObjectTemplate.create EntryPoint sFH18Entry
ObjectTemplate.setEntryRadius 3.8

rem *** sFH18_Handle_Y ***
ObjectTemplate.create RotationalBundle sFH18_Handle_Y
ObjectTemplate.geometry sFH18_Handle_Y_m1
rem ---------------------------------------------------
ObjectTemplate.setMaxSpeed 0/8000/0
ObjectTemplate.setAcceleration 0/1000/0
ObjectTemplate.setInputToPitch c_PIMouseLookY

rem *** sFH18_Wheel_L ***
ObjectTemplate.create SimpleObject sFH18_Wheel_L
ObjectTemplate.geometry sFH18_Wheel_L_m1

rem *** sFH18_Wheel_R ***
ObjectTemplate.create SimpleObject sFH18_Wheel_R
ObjectTemplate.geometry sFH18_Wheel_R_m1

rem *** sFH18Turret ***
ObjectTemplate.create RotationalBundle sFH18Turret
ObjectTemplate.setNetworkableInfo sFH18TurretInfo
ObjectTemplate.loadSoundScript ../sFH18_BG42/Sounds/sFH18Turret.ssc
ObjectTemplate.geometry sFH18_Tow_m1
ObjectTemplate.hasCollisionPhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate sFH18GunBase
ObjectTemplate.setPosition 0/0.52/-0.03
ObjectTemplate.addTemplate sFH18CamBase
ObjectTemplate.setPosition -0.45/1.1/-0.7

ObjectTemplate.addTemplate sFH18_Handle_X
ObjectTemplate.setPosition -0.41/0.17/-0.8
ObjectTemplate.addTemplate sFH18_YRod
ObjectTemplate.setPosition 0.534/0.098/-0.156
