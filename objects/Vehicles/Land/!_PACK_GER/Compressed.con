rem *** ElephantEngine ***
ObjectTemplate.create Engine ElephantEngine
ObjectTemplate.setNetworkableInfo ElephantEngineInfo
ObjectTemplate.setAttachToListener 1
ObjectTemplate.loadSoundScript ../Engines/Sounds/TigerEngine.ssc
ObjectTemplate.hasMobilePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate Elephant_Track_L
ObjectTemplate.setPosition -1.1/-1.056/0.22
ObjectTemplate.addTemplate Elephant_Track_R
ObjectTemplate.setPosition 1.23/-1.056/0.134

ObjectTemplate.addTemplate e_TankExhaust20U
ObjectTemplate.setPosition -1.28/-0.41/-0.11
ObjectTemplate.setRotation 0/0/-55
ObjectTemplate.addTemplate e_TankExhaust20U
ObjectTemplate.setPosition 1.28/-0.41/-0.11
ObjectTemplate.setRotation 0/0/55
rem -------------------------------------
ObjectTemplate.setMinRotation -1/0/-1
ObjectTemplate.setMaxRotation 1/0/1
ObjectTemplate.setMaxSpeed 250/0/250
ObjectTemplate.setAcceleration 1000/0/1000

rem ObjectTemplate.setMaxSpeed 4/0/250
rem ObjectTemplate.setAcceleration 1000/0/8

rem ObjectTemplate.setMaxSpeed 4/0/250
rem ObjectTemplate.setAcceleration 1000/0/20

rem ObjectTemplate.setMaxSpeed 4/0/250
rem ObjectTemplate.setAcceleration 1000/0/100

rem ObjectTemplate.setMaxSpeed 4/0/250
rem ObjectTemplate.setAcceleration 3/0/1000

rem ObjectTemplate.setMaxSpeed 25/0/250
rem ObjectTemplate.setAcceleration 100/0/1000

rem ObjectTemplate.setMaxSpeed 4/0/10
rem ObjectTemplate.setAcceleration 3/0/8

ObjectTemplate.setInputToYaw c_PIYaw
ObjectTemplate.setInputToRoll c_PIThrottle
ObjectTemplate.setAutomaticReset 1
ObjectTemplate.setEngineType c_ETTank
rem *** 9.23 HP/t x 2
ObjectTemplate.setTorque 3.5
rem ObjectTemplate.setTorque 1.75
rem *** 30 km/h
ObjectTemplate.setDifferential 2.25
ObjectTemplate.setNumberOfGears 5
ObjectTemplate.setGearUp 0.95
ObjectTemplate.setGearDown 0.45
ObjectTemplate.setGearChangeTime 0.05


