ObjectTemplate.setPosition 0/0.4454/-0.0441
ObjectTemplate.addTemplate leFH18CamBase
ObjectTemplate.setPosition -0.4/0.55/0.3

ObjectTemplate.addTemplate leFH18Handle1
ObjectTemplate.setPosition -0.3744/0.1371/-0.1348
ObjectTemplate.addTemplate leFH18Handle2
ObjectTemplate.setPosition 0.3781/0.1371/-0.1102
ObjectTemplate.setRotation 43.3/0/0

ObjectTemplate.addTemplate leFH18Gunner_Seat
ObjectTemplate.setPosition -0.4/0.05/-1.2
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMinRotation -28/0/0
	ObjectTemplate.setMaxRotation 28/0/0
	ObjectTemplate.setMaxSpeed 10/0/0
	ObjectTemplate.setAcceleration 58/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

