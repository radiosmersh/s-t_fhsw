rem ============================================================================
rem folder = Bergetiger
rem sauce = Geometries.con
rem ============================================================================
renderer.beginGlobalCluster Bergetiger

GeometryTemplate.create StandardMesh Bergetiger_bow_mg34
GeometryTemplate.file bow_mg34
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 60
GeometryTemplate.setLodDistance 3 100


GeometryTemplate.create StandardMesh 1p_Bergetiger_Gunner_m1
GeometryTemplate.file 1p_88_reticule_m1

GeometryTemplate.create StandardMesh Bergetiger_Hull_M1
GeometryTemplate.file Tiger_Hull_M1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 35
GeometryTemplate.setLodDistance 3 50
GeometryTemplate.setLodDistance 4 75
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Bergetiger_Hull_Hatch_M1
GeometryTemplate.file Tiger_Hull_Hatch_M1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 30
GeometryTemplate.setLodDistance 3 40
GeometryTemplate.setLodDistance 4 80
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Bergetiger_Tow_M1
GeometryTemplate.file bergetiger_tow_m1
GeometryTemplate.setLodDistance 0 400
GeometryTemplate.setLodDistance 1 401
GeometryTemplate.setLodDistance 2 402
GeometryTemplate.setLodDistance 3 403
GeometryTemplate.setLodDistance 4 404
GeometryTemplate.setLodDistance 5 405

GeometryTemplate.create StandardMesh Bergetiger_Tower_Hatch_M1
GeometryTemplate.file Tiger_Tow_Hatch_M1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 30
GeometryTemplate.setLodDistance 3 40
GeometryTemplate.setLodDistance 4 80
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Bergetiger_Mgun_con_m1
GeometryTemplate.file PanzerIV_Mgun_con_m1
geometryTemplate.cullFactor 0.4
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Bergetiger_MGun_mount_M1
GeometryTemplate.file Tank_Mgun_Mount_m1
geometryTemplate.cullFactor 0.4
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
