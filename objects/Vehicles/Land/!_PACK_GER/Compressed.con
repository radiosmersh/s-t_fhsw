ObjectTemplate.setNetworkableInfo TankFireArmInfo_ForceID
rem -------------------------------------
ObjectTemplate.projectileTemplate Arty12,8cmL55Projectile_Tracer
ObjectTemplate.projectilePosition 0/0/4
ObjectTemplate.setMinDev 0
ObjectTemplate.magSize 999
ObjectTemplate.numOfMag 999
ObjectTemplate.velocity 460
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 2
ObjectTemplate.roundOfFire 5
ObjectTemplate.setInputFire c_PIAltFire

rem ===== EOF =====
rem ============================================================================
rem folder = K81Battery
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo K81BatteryTraverseInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo K81BatteryTurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo K81BatteryGunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo K81BatteryBodyInfo
NetworkableInfo.setPredictionMode PMLinear

rem ===== EOF =====
rem ============================================================================
rem folder = K81Battery
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1

