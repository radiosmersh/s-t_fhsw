rem ============================================================================
rem folder = Panther-Gerat58AA
rem sauce = Geometries.con
rem ============================================================================
renderer.beginGlobalCluster Panther-Gerat58AA

GeometryTemplate.create StandardMesh Panther-Gerat58AA_bow_mg34
GeometryTemplate.file bow_mg34
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 60
GeometryTemplate.setLodDistance 3 100

GeometryTemplate.create StandardMesh Panther-Gerat58AA_Cannon_M1
GeometryTemplate.file PantherAA55_barrel_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 30
GeometryTemplate.setLodDistance 3 40
GeometryTemplate.setLodDistance 4 80
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Panther-Gerat58AA_Cannon_Shield_M1
GeometryTemplate.file PantherAA55_gunbase_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 30
GeometryTemplate.setLodDistance 3 40
GeometryTemplate.setLodDistance 4 80
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh 1p_Panther-Gerat58AA_Gunner_m1
GeometryTemplate.file 1p_AAtank_aim_ger

GeometryTemplate.create StandardMesh Panther-Gerat58AA_mg34_view
GeometryTemplate.file 1p_Hull_MGView_m1

GeometryTemplate.create StandardMesh Panther-Gerat58AA_Hull_M1
GeometryTemplate.file PantherD_Hull_m1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 35
GeometryTemplate.setLodDistance 3 50
GeometryTemplate.setLodDistance 4 75
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Panther-Gerat58AA_Tow_M1
GeometryTemplate.file PantherAA55_Tow_m1
GeometryTemplate.setLodDistance 0 400
GeometryTemplate.setLodDistance 1 401
GeometryTemplate.setLodDistance 2 402
GeometryTemplate.setLodDistance 3 403
GeometryTemplate.setLodDistance 4 404
GeometryTemplate.setLodDistance 5 405

renderer.endGlobalCluster

GeometryTemplate.create StandardMesh Panther-Gerat58AA_Hull_L1
GeometryTemplate.file PantherAA55_hull_l1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 200
GeometryTemplate.setLodDistance 2 250
GeometryTemplate.setLodDistance 3 300
GeometryTemplate.setLodDistance 4 350
GeometryTemplate.setLodDistance 5 500

GeometryTemplate.create StandardMesh Wreck_Panther-Gerat58AA_M1
GeometryTemplate.file Wrecked_PantherD
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 200
GeometryTemplate.setLodDistance 2 250
GeometryTemplate.setLodDistance 3 300
GeometryTemplate.setLodDistance 4 350
GeometryTemplate.setLodDistance 5 500

rem ===== EOF =====
rem ============================================================================
rem folder = Panther-Gerat58AA
rem sauce = Network.con
rem ============================================================================
NetworkableInfo.createNewInfo Panther-Gerat58AATurretInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo Panther-Gerat58AAGunInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo Panther-Gerat58AAEngineInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo Panther-Gerat58AABodyInfo
NetworkableInfo.setPredictionMode PMLinear

NetworkableInfo.createNewInfo Panther-Gerat58AAPassengerInfo
NetworkableInfo.setPredictionMode PMNone
NetworkableInfo.setBasePriority 0

rem ===== EOF =====
rem ============================================================================
rem folder = Panther-Gerat58AA
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1


rem *** Panther-Gerat58AA ***
ObjectTemplate.create PlayerControlObject Panther-Gerat58AA
ObjectTemplate.setNetworkableInfo Panther-Gerat58AABodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 4
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasDynamicShadow 1
ObjectTemplate.explosionRadius 8
ObjectTemplate.explosionDamage 2
ObjectTemplate.drag 2
ObjectTemplate.mass 45000
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.hasArmor 1
ObjectTemplate.speedMod 0.75
ObjectTemplate.exitTimer 1
ObjectTemplate.hitpoints 127
ObjectTemplate.maxhitpoints 127
ObjectTemplate.material 48
ObjectTemplate.criticalDamage 10
if v_is_coop == True
	ObjectTemplate.hpLostWhileCriticalDamage 1
else
	ObjectTemplate.hpLostWhileCriticalDamage 0
endIf
ObjectTemplate.explosionForceMod 6
ObjectTemplate.hpLostWhileUpSideDown 7
ObjectTemplate.hpLostWhileDamageFromWater 7
ObjectTemplate.addArmorEffect 50 e_PanzDamage 0/0/-1.4
ObjectTemplate.addArmorEffect 10 e_PanzFire 0/0/-1.8
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect -1 WaterWaterExplosion 0/0/0
ObjectTemplate.timetoliveafterdeath 40
ObjectTemplate.fadeAtTimeToLiveAfterDeath 0
ObjectTemplate.damageFromWater 0
ObjectTemplate.aiTemplate Panther-Gerat58AA
rem -------------------------------------
ObjectTemplate.addTemplate lodPanther-Gerat58AA
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation -2.3/0.5/0 0/0/0
ObjectTemplate.GUIIndex 75
ObjectTemplate.submarineData 1 0.03 10.0 1.5 2.4 1.4 5
ObjectTemplate.setVehicleIcon "Vehicle/icon_Flakpanzer5,5cm.tga"
ObjectTemplate.setVehicleIconPos 49/70
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_55mmGeraet58_HE+APT_White.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setSecondaryAmmoIcon "Ammo/icon_20mmMG151-20.tga"
ObjectTemplate.setSecondaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setHasTurretIcon 1
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTHeavyTank
ObjectTemplate.setToolTipType  TTHeavyTank
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_AAtank_16x16.tga"
ObjectTemplate.hasRestrictedExit 1


rem *** lodPanther-Gerat58AA ***
ObjectTemplate.create LodObject lodPanther-Gerat58AA
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
