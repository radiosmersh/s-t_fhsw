rem *** E-10Cannon ***
ObjectTemplate.create FireArms E-10Cannon
ObjectTemplate.setNetworkableInfo TankFireArmInfo
ObjectTemplate.loadSoundScript ../E-10/Sounds/E-10Cannon.ssc
ObjectTemplate.geometry E-10_gun
ObjectTemplate.aiTemplate JagdpanzerMainGun
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_75_750_Main
ObjectTemplate.setPosition 0/0/1.9273
rem -------------------------------------
ObjectTemplate.setMinDev 0.36
ObjectTemplate.projectileTemplate 75mmL24HEAT_Hl-Klw_DP_Projectile
ObjectTemplate.projectilePosition 0/0.3/1
rem ObjectTemplate.projectilePosition 0/0/1
ObjectTemplate.magSize 44
ObjectTemplate.numOfMag 1
ObjectTemplate.velocity 395
ObjectTemplate.autoReload 1
ObjectTemplate.reloadtime 0.3
ObjectTemplate.roundOfFire 0.233
ObjectTemplate.fireingForce 40
ObjectTemplate.recoilSpeed 10
ObjectTemplate.recoilSize 15
