rem *** K81Battery5 ***
ObjectTemplate.create PlayerControlObject K81Battery5
ObjectTemplate.setNetworkableInfo K81BatteryBodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.explosionRadius 4
ObjectTemplate.explosionDamage 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 108
ObjectTemplate.maxhitpoints 108
ObjectTemplate.material 34
ObjectTemplate.addArmorEffect 40 e_PanzDamage 0/1.3/0
ObjectTemplate.addArmorEffect 40 e_PanzDamage 9/1.3/-0.5
ObjectTemplate.addArmorEffect 40 e_PanzDamage -7/1.3/0.4
ObjectTemplate.addArmorEffect 40 e_PanzDamage -16/1.3/-0.4
ObjectTemplate.addArmorEffect 40 e_PanzDamage 15/1.3/0.8
ObjectTemplate.addArmorEffect 10 e_PanzFire 0/1.0/0
ObjectTemplate.addArmorEffect 10 e_PanzFire 9/1.0/-0.5
ObjectTemplate.addArmorEffect 10 e_PanzFire -7/1.0/0.4
ObjectTemplate.addArmorEffect 10 e_PanzFire -16/1.0/-0.4
ObjectTemplate.addArmorEffect 10 e_PanzFire 15/1.0/0.8
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas 9/0/-0.5
ObjectTemplate.addArmorEffect 0 e_ExplGas -7/0/0.4
ObjectTemplate.addArmorEffect 0 e_ExplGas -16/0/-0.4
ObjectTemplate.addArmorEffect 0 e_ExplGas 15/0/0.8
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke 9/0/-0.5
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke -7/0/0.4
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke -16/0/-0.4
ObjectTemplate.addArmorEffect 0 e_scrapmetalsmoke 15/0/0.8
ObjectTemplate.aiTemplate K433(r)Battery
ObjectTemplate.timetoliveafterdeath 10
rem -------------------------------------
ObjectTemplate.addTemplate lodK81Battery5
ObjectTemplate.setPosition 0/0.2/0
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation -0.6/0.3/-1.5 0/0/0
ObjectTemplate.GUIIndex 19
ObjectTemplate.setVehicleIcon "Vehicle/icon_K81.tga"
ObjectTemplate.setVehicleIconPos 64/29
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_128mmK81.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
