rem *** PaK42Complex ***
ObjectTemplate.create RotationalBundle PaK42Complex
ObjectTemplate.setNetworkableInfo PaK42BodyInfo
ObjectTemplate.loadSoundScript ../Common/Sounds/Traverse_Mediumgun.ssc
ObjectTemplate.geometry PaK40_carriage_M1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate PaK42Entry
ObjectTemplate.addTemplate PaK42Mount
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMaxSpeed 5/0/0
	ObjectTemplate.setAcceleration 10/0/0
	ObjectTemplate.setInputToYaw c_PIYaw
else
	ObjectTemplate.setMaxSpeed 11/0/0
	ObjectTemplate.setAcceleration 60/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

rem *** PaK42Entry ***
ObjectTemplate.create EntryPoint PaK42Entry
ObjectTemplate.setEntryRadius 3.2

