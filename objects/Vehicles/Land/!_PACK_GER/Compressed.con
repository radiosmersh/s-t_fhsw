NetworkableInfo.setPredictionMode PMLinear
rem ===== EOF =====
rem ============================================================================
rem folder = leFH18_HF
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1

rem *** leFH18 ***
ObjectTemplate.create PlayerControlObject leFH18
ObjectTemplate.setNetworkableInfo leFH18BodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.explosionRadius 4
ObjectTemplate.explosionDamage 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 104
ObjectTemplate.maxhitpoints 104
ObjectTemplate.material 32
ObjectTemplate.addArmorEffect 40 e_PanzDamage 0/1/-1.4
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.aiTemplate leFH18
ObjectTemplate.timetoliveafterdeath 10
rem -------------------------------------
ObjectTemplate.addTemplate lodleFH18
ObjectTemplate.setPosition 0/0.8/0
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation 0/0.5/-2.0 0/0/0
ObjectTemplate.GUIIndex 19
ObjectTemplate.setVehicleIcon "Vehicle/icon_leFH18_AmmoSelect.tga"
ObjectTemplate.setVehicleIconPos 81/83
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_105mmleFH18_HE+HEAT.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_artillery_16x16.tga"
ObjectTemplate.artPos 1
ObjectTemplate.DirBarXScale 180
ObjectTemplate.DirBarYScaleAbove 90
ObjectTemplate.DirBarYScaleBelow 0
ObjectTemplate.DirBarYScaleMin -90
ObjectTemplate.DirBarYScaleMax 0



rem *** lodleFH18 ***
ObjectTemplate.create LodObject lodleFH18
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate leFH18Complex
ObjectTemplate.addTemplate leFH18Simple
ObjectTemplate.addTemplate leFH18Wreck
rem -------------------------------------
ObjectTemplate.lodSelector leFH18LodSelector


rem *** leFH18Complex ***
ObjectTemplate.create RotationalBundle leFH18Complex
ObjectTemplate.setNetworkableInfo leFH18BodyInfo
ObjectTemplate.loadSoundScript ../Common/Sounds/Traverse_Mediumgun.ssc
ObjectTemplate.geometry leFH18_base_m1
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate leFH18Entry
ObjectTemplate.setPosition 0/0.0/1.2
ObjectTemplate.addTemplate leFH18GunBase
ObjectTemplate.setPosition 0/0/-0.2
rem -------------------------------------
if v_is_coop == False
	ObjectTemplate.setMaxSpeed 5/0/0
	ObjectTemplate.setAcceleration 10/0/0
	ObjectTemplate.setInputToYaw c_PIYaw
else
	ObjectTemplate.setMaxSpeed 10/0/0
	ObjectTemplate.setAcceleration 58/0/0
	ObjectTemplate.setInputToYaw c_PIMouseLookX
endIf

