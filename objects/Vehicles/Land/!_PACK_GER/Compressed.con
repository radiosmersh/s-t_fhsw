ObjectTemplate.GUIIndex 19
ObjectTemplate.setSoldierExitLocation 0/0/-3.1 180/0/0
ObjectTemplate.setVehicleIcon "Vehicle/Icon_IG37.tga"
ObjectTemplate.setVehicleIconPos 84/74
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_75mmIG37HEAT_C.tga"
