rem ============================================================================
rem folder = Ostwind
rem sauce = Geometries.con
rem ============================================================================

renderer.beginGlobalCluster Ostwind

GeometryTemplate.create StandardMesh Ostwind_Gunbase
GeometryTemplate.file Ostwind_Gunbase_m1
geometryTemplate.cullFactor 0.2
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Ostwind_Sight_m1
GeometryTemplate.file Ostwind_Sight_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Ostwind_turret
GeometryTemplate.file ostwind_tow
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

renderer.endGlobalCluster

GeometryTemplate.create StandardMesh Ostwind_Hull_L1
GeometryTemplate.file Wirbelwind_LOD_m1

GeometryTemplate.create StandardMesh Wreck_Ostwind_m1
GeometryTemplate.file Wirbelwind_wreck_m1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 150
GeometryTemplate.setLodDistance 2 200
GeometryTemplate.setLodDistance 3 250
GeometryTemplate.setLodDistance 4 300
GeometryTemplate.setLodDistance 5 500

