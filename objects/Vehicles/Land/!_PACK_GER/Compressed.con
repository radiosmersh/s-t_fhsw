ObjectTemplate.addTemplate lodMaus_
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation 0/4/0 0/0/0
ObjectTemplate.GUIIndex 75
ObjectTemplate.submarineData 1 0.03 10.0 1.5 2.4 1.58 5
ObjectTemplate.setVehicleIcon "Vehicle/icon_Maus.tga"
ObjectTemplate.setVehicleIconPos 89/55
ObjectTemplate.setNumberOfWeaponIcons 2
