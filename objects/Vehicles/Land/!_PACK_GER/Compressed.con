ObjectTemplate.setSoldierExitLocation -2/0/0 0/0/0
ObjectTemplate.GUIIndex 140
ObjectTemplate.submarineData 1 0.03 10.0 1.1 1.2 0.5 5
ObjectTemplate.setVehicleIcon "Vehicle/icon_Panzer2G.tga"
ObjectTemplate.setVehicleIconPos 75/61
ObjectTemplate.setNumberOfWeaponIcons 2
ObjectTemplate.setPrimaryAmmoIcon "Ammo/icon_20mmKwK38RndAPCR.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setSecondaryAmmoIcon "Ammo/icon_7,92mmMG34.tga"
ObjectTemplate.setSecondaryAmmoBar ABAmmoBarHeatBar
ObjectTemplate.setHasTurretIcon 1
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_lighttank_16x16.tga"
