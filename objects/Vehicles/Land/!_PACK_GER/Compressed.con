rem *** RatteEngine ***
ObjectTemplate.create Engine RatteEngine
ObjectTemplate.setNetworkableInfo RatteEngineInfo
ObjectTemplate.setAttachToListener 1
ObjectTemplate.loadSoundScript ../Ratte/Sounds/RatteEngine.ssc
ObjectTemplate.hasMobilePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate Ratte_L_Track
ObjectTemplate.setPosition -5.75/0/0.5
ObjectTemplate.addTemplate Ratte_R_Track
ObjectTemplate.setPosition 5.75/0/0.5
rem -------------------------------------
ObjectTemplate.setMinRotation -1/0/-1
ObjectTemplate.setMaxRotation 1/0/1
ObjectTemplate.setMaxSpeed 4/0/10
ObjectTemplate.setAcceleration 3/0/8
ObjectTemplate.setInputToYaw c_PIYaw
ObjectTemplate.setInputToRoll c_PIThrottle
ObjectTemplate.setAutomaticReset 1
ObjectTemplate.setEngineType c_ETTank
ObjectTemplate.setTorque 30.0
rem ObjectTemplate.setTorque 2.03
ObjectTemplate.setDifferential 0.66
rem ObjectTemplate.setDifferential 0.7
rem ObjectTemplate.setDifferential 0.8
rem ObjectTemplate.setDifferential 0.6
rem ObjectTemplate.setDifferential 2.28
ObjectTemplate.setNumberOfGears 5
ObjectTemplate.setGearUp 0.95
ObjectTemplate.setGearDown 0.45
ObjectTemplate.setGearChangeTime 0.05




