rem ============================================================================
rem folder = WespeBattery
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1


rem *** WespeBattery ***
ObjectTemplate.create PlayerControlObject WespeBattery
ObjectTemplate.NameTagOffset 0/-0.5/0
ObjectTemplate.setNetworkableInfo WespeBodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 5
ObjectTemplate.hasMobilePhysics 0
ObjectTemplate.hasDynamicShadow 1
ObjectTemplate.explosionRadius 8
ObjectTemplate.explosionDamage 3
ObjectTemplate.exitTimer 1
ObjectTemplate.drag 8
ObjectTemplate.mass 11400
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.hasArmor 1
ObjectTemplate.hitpoints 86
ObjectTemplate.maxhitpoints 86
ObjectTemplate.material 33
ObjectTemplate.criticalDamage 8
if v_is_coop == True
	ObjectTemplate.hpLostWhileCriticalDamage 1
else
	ObjectTemplate.hpLostWhileCriticalDamage 0
endIf
ObjectTemplate.explosionForceMod 13
ObjectTemplate.hpLostWhileUpSideDown 5
ObjectTemplate.hpLostWhileDamageFromWater 5
ObjectTemplate.speedMod 2
ObjectTemplate.addArmorEffect 30 e_WespeDamage 0/0.2/0.5
ObjectTemplate.addArmorEffect 30 e_WespeDamage 9/0.2/0
ObjectTemplate.addArmorEffect 30 e_WespeDamage -7/0.2/0.5
ObjectTemplate.addArmorEffect 30 e_WespeDamage -16/0.2/0.5
ObjectTemplate.addArmorEffect 5 e_WespeFire 0/0.6/1
ObjectTemplate.addArmorEffect 5 e_WespeFire 9/0.6/0.5
ObjectTemplate.addArmorEffect 5 e_WespeFire -7/0.6/1
ObjectTemplate.addArmorEffect 5 e_WespeFire -16/0.6/1
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas 9/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal 9/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas -7/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal -7/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas -16/0/0
ObjectTemplate.addArmorEffect 0 e_scrapmetal -16/0/0
ObjectTemplate.timetoliveafterdeath 10
ObjectTemplate.fadeAtTimeToLiveAfterDeath 0
ObjectTemplate.damageFromWater 0
ObjectTemplate.aiTemplate WespeBattery
rem -------------------------------------
ObjectTemplate.addTemplate lodWespeBattery
rem -------------------------------------
ObjectTemplate.setSoldierExitLocation -2/0.5/0 0/0/0
ObjectTemplate.GUIIndex 76
ObjectTemplate.setVehicleIcon "Vehicle/Icon_wespe.tga"
ObjectTemplate.setVehicleIconPos 55/94
ObjectTemplate.setNumberOfWeaponIcons 1
ObjectTemplate.setPrimaryAmmoIcon "Ammo/Icon_105mmleFH18M.tga"
ObjectTemplate.setPrimaryAmmoBar ABAmmoBarReloadBar
ObjectTemplate.setCrossHairType CHTNone
ObjectTemplate.setVehicleCategory VCLand
ObjectTemplate.setVehicleType  VTArtillery
ObjectTemplate.setToolTipType  TTArtillery
ObjectTemplate.setMinimapIcon "Minimap/minimap_icon_spbattery_16x16.tga"
ObjectTemplate.artPos 1
ObjectTemplate.DirBarXScale 180
ObjectTemplate.DirBarYScaleAbove 90
ObjectTemplate.DirBarYScaleBelow 0
ObjectTemplate.DirBarYScaleMin -90
ObjectTemplate.DirBarYScaleMax 0
ObjectTemplate.hasRestrictedExit 1


