rem ===== EOF =====
rem ============================================================================
rem folder = PantherD
rem sauce = Objects.con
rem ============================================================================
rem ===== COMPRESS = GER

Var v_is_coop
console.useRelativePaths 0
run bf1942/game/is_coop.con
console.useRelativePaths 1


rem *** PantherD ***
ObjectTemplate.create PlayerControlObject PantherD
ObjectTemplate.setNetworkableInfo PantherDBodyInfo
ObjectTemplate.saveInSeparateFile 1
objectTemplate.cullRadiusScale 4
ObjectTemplate.hasMobilePhysics 1
ObjectTemplate.hasDynamicShadow 1
ObjectTemplate.explosionRadius 8
ObjectTemplate.explosionDamage 2
ObjectTemplate.drag 2
ObjectTemplate.mass 45000
ObjectTemplate.hasCollisionPhysics 1
ObjectTemplate.hasResponsePhysics 1
ObjectTemplate.hasArmor 1
ObjectTemplate.speedMod 0.75
ObjectTemplate.exitTimer 1
ObjectTemplate.hitpoints 138
ObjectTemplate.maxhitpoints 138
ObjectTemplate.material 48
ObjectTemplate.criticalDamage 13
if v_is_coop == True
	ObjectTemplate.hpLostWhileCriticalDamage 1
else
	ObjectTemplate.hpLostWhileCriticalDamage 0
endIf
ObjectTemplate.explosionForceMod 6
ObjectTemplate.hpLostWhileUpSideDown 7
ObjectTemplate.hpLostWhileDamageFromWater 7
ObjectTemplate.addArmorEffect 50 e_PanzDamage 0/0/-1.4
ObjectTemplate.addArmorEffect 13 e_PanzFire 0/0/-1.8
ObjectTemplate.addArmorEffect 0 e_scrapmetal 0/0/0
ObjectTemplate.addArmorEffect 0 e_ExplGas 0/0/0
ObjectTemplate.addArmorEffect -1 WaterWaterExplosion 0/0/0
ObjectTemplate.timetoliveafterdeath 40
ObjectTemplate.fadeAtTimeToLiveAfterDeath 0
ObjectTemplate.damageFromWater 0
ObjectTemplate.aiTemplate PantherD
