ObjectTemplate.setAcceleration 5/0/50
rem ObjectTemplate.setAcceleration 15/0/50
rem ObjectTemplate.setAcceleration 5/0/10

ObjectTemplate.setInputToYaw c_PIYaw
ObjectTemplate.setInputToRoll c_PIThrottle
