rem ============================================================================
rem folder = Pz740(f)
rem sauce = Geometries.con
rem ============================================================================
renderer.beginGlobalCluster Pz740(f)

GeometryTemplate.create StandardMesh Pz740(f)_Front_Cannon_M1
