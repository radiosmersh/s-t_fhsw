rem *** E-10Engine ***
ObjectTemplate.create Engine E-10Engine
ObjectTemplate.setNetworkableInfo E-10EngineInfo
ObjectTemplate.setAttachToListener 1
ObjectTemplate.loadSoundScript ../Engines/Sounds/HL230Engine.ssc
ObjectTemplate.hasMobilePhysics 1
rem -------------------------------------
ObjectTemplate.addTemplate E-10_Track_Left
ObjectTemplate.setPosition -0.001/0/0
ObjectTemplate.addTemplate E-10_Track_Right
ObjectTemplate.setPosition 0.001/0/0

ObjectTemplate.addTemplate e_TankExhaust20
ObjectTemplate.setPosition -0.3856/1.1279/-2.23798
ObjectTemplate.setRotation 0/0/0
ObjectTemplate.addTemplate e_TankExhaust20
ObjectTemplate.setPosition 0.406/1.1279/-2.23798
ObjectTemplate.setRotation 0/0/0

ObjectTemplate.addTemplate E-10_SuspensionElevator_RotationFL
ObjectTemplate.setPosition -0.001/0.22/1.5
ObjectTemplate.addTemplate E-10_SuspensionElevator_RotationBL
ObjectTemplate.setPosition -0.001/0.22/-1.8

ObjectTemplate.addTemplate E-10_SuspensionElevator_RotationFR
ObjectTemplate.setPosition 0.001/0.22/1.5
ObjectTemplate.addTemplate E-10_SuspensionElevator_RotationBR
ObjectTemplate.setPosition 0.001/0.22/-1.8
rem -------------------------------------
ObjectTemplate.setMinRotation -1/0/-1
ObjectTemplate.setMaxRotation 1/0/1
ObjectTemplate.setMaxSpeed 250/0/250
ObjectTemplate.setAcceleration 1000/0/1000
ObjectTemplate.setInputToYaw c_PIYaw
ObjectTemplate.setInputToRoll c_PIThrottle
ObjectTemplate.setAutomaticReset 1
ObjectTemplate.setEngineType c_ETTank
rem *** 36.67 HP/t
ObjectTemplate.setTorque 8.56
rem *** 70 km/h
ObjectTemplate.setDifferential 5.25
rem remove for F8+R8 Gears
rem ObjectTemplate.setNumberOfGears 5
rem ObjectTemplate.setGearUp 0.95
rem ObjectTemplate.setGearDown 0.45
rem ObjectTemplate.setGearChangeTime 0.05


