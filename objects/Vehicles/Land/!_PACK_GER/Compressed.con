rem *** ML-20BatteryCannon1 ***
ObjectTemplate.create FireArms ML-20BatteryCannon1
ObjectTemplate.setNetworkableInfo TankFireArmInfo_ForceID
ObjectTemplate.loadSoundScript ../ML-20/Sounds/ML-20Cannon.ssc
ObjectTemplate.geometry ML-20_Barrel_m1
ObjectTemplate.aiTemplate ML-20MainGun
rem -------------------------------------
ObjectTemplate.addTemplate e_MuzzSW_130_500_Main
ObjectTemplate.setPosition 0/0/4.4996
ObjectTemplate.addTemplate e_MuzzSW_150_500_Liner45
ObjectTemplate.setPosition -0.1207/0/4.1895
ObjectTemplate.setRotation -90/0/0
ObjectTemplate.addTemplate e_MuzzSW_150_500_Liner45
ObjectTemplate.setPosition 0.1207/0/4.1895
ObjectTemplate.setRotation 90/0/0

ObjectTemplate.addTemplate e_CartridgeEjection_152x513R
ObjectTemplate.setInputId 0
ObjectTemplate.startoneffects 1
ObjectTemplate.setPosition 0/0.1827/-0.3
rem -------------------------------------
ObjectTemplate.projectileTemplate Arty15,2cmL28,8Projectile
ObjectTemplate.projectilePosition 0/0/4
ObjectTemplate.setMinDev 0.63
rem *** BATTERY MOD
ObjectTemplate.magSize 4
rem ObjectTemplate.magSize 100
rem *** BATTERY MOD
ObjectTemplate.reloadtime 30
rem ObjectTemplate.reloadtime 0.2
ObjectTemplate.numOfMag -1
ObjectTemplate.autoReload 1
ObjectTemplate.velocity 327.5
ObjectTemplate.roundOfFire 0.075
rem towed gun tweak
rem ObjectTemplate.fireingForce 90
ObjectTemplate.recoilSpeed 10
ObjectTemplate.recoilSize 40
ObjectTemplate.setFireCameraShakeAnimationState FireTank150CanonShake

