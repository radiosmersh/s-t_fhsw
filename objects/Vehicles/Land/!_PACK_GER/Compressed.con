GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 10
GeometryTemplate.setLodDistance 2 15
GeometryTemplate.setLodDistance 3 30
GeometryTemplate.setLodDistance 4 50
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Pz740(f)_barrel_M1
GeometryTemplate.file Pz740(f)_barrel
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 35
GeometryTemplate.setLodDistance 2 45
GeometryTemplate.setLodDistance 3 75
GeometryTemplate.setLodDistance 4 85
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Pz740(f)_Cannon_M1
GeometryTemplate.file Pz740(f)_gun
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 35
GeometryTemplate.setLodDistance 2 45
GeometryTemplate.setLodDistance 3 75
GeometryTemplate.setLodDistance 4 85
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Pz740(f)_Tow_M1
GeometryTemplate.file Pz740(f)_tower
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 35
GeometryTemplate.setLodDistance 2 45
GeometryTemplate.setLodDistance 3 75
GeometryTemplate.setLodDistance 4 85
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create StandardMesh Pz740(f)_Hull_M1
GeometryTemplate.file Pz740(f)_hull_m1
GeometryTemplate.hasDynamicShadow 1
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 35
GeometryTemplate.setLodDistance 2 45
GeometryTemplate.setLodDistance 3 75
GeometryTemplate.setLodDistance 4 85
GeometryTemplate.setLodDistance 5 100

GeometryTemplate.create AnimatedMesh Pz740(f)_TrackL_M1
GeometryTemplate.file charb1_trackL
GeometryTemplate.setSkin animations/charb1_trackL.skn

GeometryTemplate.create AnimatedMesh Pz740(f)_TrackR_M1
GeometryTemplate.file charb1_trackR
GeometryTemplate.setSkin animations/charb1_trackR.skn

GeometryTemplate.create StandardMesh Pz740(f)_B_Whel
GeometryTemplate.file Pz740(f)_Bwheel
GeometryTemplate.setLodDistance 0 0
GeometryTemplate.setLodDistance 1 20
GeometryTemplate.setLodDistance 2 60
GeometryTemplate.setLodDistance 3 150

GeometryTemplate.create StandardMesh Pz740(f)_S_Whel
